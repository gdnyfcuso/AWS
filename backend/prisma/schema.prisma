// Prisma Schema for Agent World Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Agent 相关 ====================

model Agent {
  id              String   @id @default(cuid())
  agent_id        String   @unique
  agent_name      String
  agent_type      String
  webhook_url     String?
  api_key         String   @unique
  capabilities    Json?
  preferences     Json?

  // 真实世界地理位置
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  country         String?

  status          String   @default("offline")
  last_ping       DateTime?

  home_location_id String?
  home_location    Location?  @relation(fields: [home_location_id], references: [id])

  // VWAP v2 新增字段
  protocol_version String   @default("v1")
  avatar_id       String?   @unique
  platform_adapter String?  // 'openai' | 'claude' | 'discord' | 'telegram' | 'custom'

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  disconnected_at DateTime?

  state           AgentState?
  actions         Action[]
  events          Event[]
  relationships   Relationship[] @relation("agent_relationships")
  relationships2  Relationship[] @relation("agent_target_relationships")
  sent_messages   ChatMessage[] @relation("message_sender")
  received_messages ChatMessage[] @relation("message_receiver")
  transactions    Transaction[] @relation("transaction_sender")
  transactions2   Transaction[] @relation("transaction_receiver")

  // VWAP v2 关系
  physiological_needs PhysiologicalNeeds?
  emotional_state     EmotionalState?
  skills              Skills?
  avatar              Avatar?
  platform_adapters   PlatformAdapter[]

  // 3D虚拟空间扩展关系
  owned_vehicles      Vehicle[]        @relation("vehicle_owner")
  vehicle_interactions VehicleInteraction[] @relation("vehicle_interactions")
}

model AgentState {
  id              String   @id @default(cuid())
  agent_id        String   @unique
  agent           Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  location_id     String
  location        Location @relation(fields: [location_id], references: [id])

  money           Decimal  @default(1000)
  energy          Int      @default(100)
  mood            String   @default("neutral")
  health          Int      @default(100)

  total_earned    Decimal  @default(0)
  total_spent     Decimal  @default(0)
  interactions_count Int   @default(0)

  updated_at      DateTime @updatedAt

  @@index([location_id])
}

// ==================== 位置相关 ====================

model Location {
  id              String   @id @default(cuid())
  location_id     String   @unique
  name            String
  description     String?
  type            String
  coordinates     Json

  max_capacity    Int?
  current_agents  Int      @default(0)

  residents       Agent[]
  agents_present  AgentState[]

  parent_location_id String?
  parent_location  Location?  @relation("location_hierarchy", fields: [parent_location_id], references: [id])
  sub_locations    Location[] @relation("location_hierarchy")

  created_at      DateTime @default(now())

  @@index([type])
}

// ==================== 行动相关 ====================

model Action {
  id              String   @id @default(cuid())
  agent_id        String
  agent           Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  action_type     String
  parameters      Json?
  reasoning       String?

  success         Boolean
  result          Json?
  error_message   String?

  state_changes   Json?

  performed_at    DateTime @default(now())

  @@index([agent_id])
  @@index([performed_at])
}

// ==================== 事件相关 ====================

model Event {
  id              String   @id @default(cuid())
  event_type      String
  timestamp       DateTime @default(now())

  data            Json

  agent_id        String?
  agent           Agent?   @relation(fields: [agent_id], references: [agent_id], onDelete: SetNull)

  delivered       Boolean  @default(false)
  delivered_at    DateTime?

  @@index([event_type])
  @@index([timestamp])
  @@index([agent_id])
}

// ==================== 社交相关 ====================

model Relationship {
  id              String   @id @default(cuid())
  agent_id        String
  agent           Agent    @relation("agent_relationships", fields: [agent_id], references: [agent_id], onDelete: Cascade)

  target_agent_id String
  target_agent    Agent    @relation("agent_target_relationships", fields: [target_agent_id], references: [agent_id], onDelete: Cascade)

  relationship_type String @default("stranger")
  relationship_level Int  @default(0)

  interactions_count Int   @default(0)
  last_interaction DateTime?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([agent_id, target_agent_id])
  @@index([agent_id])
  @@index([target_agent_id])
}

model ChatMessage {
  id              String   @id @default(cuid())
  sender_id       String
  sender          Agent    @relation("message_sender", fields: [sender_id], references: [agent_id], onDelete: Cascade)

  receiver_id     String
  receiver        Agent    @relation("message_receiver", fields: [receiver_id], references: [agent_id], onDelete: Cascade)

  message         String
  message_type    String   @default("text")

  location_id     String

  sent_at         DateTime @default(now())
  read_at         DateTime?

  @@index([sender_id])
  @@index([receiver_id])
  @@index([sent_at])
}

// ==================== 经济相关 ====================

model Transaction {
  id              String   @id @default(cuid())
  sender_id       String
  sender          Agent    @relation("transaction_sender", fields: [sender_id], references: [agent_id], onDelete: Cascade)

  receiver_id     String
  receiver        Agent    @relation("transaction_receiver", fields: [receiver_id], references: [agent_id], onDelete: Cascade)

  amount          Decimal
  transaction_type String

  description     String?
  metadata        Json?

  created_at      DateTime @default(now())

  @@index([sender_id])
  @@index([receiver_id])
  @@index([created_at])
}

// ==================== 世界状态 ====================

model WorldState {
  id              String   @id @default(cuid())

  world_time      String
  world_date      String
  day_phase       String

  weather         String   @default("sunny")
  season          String   @default("spring")

  active_agents   Int      @default(0)
  total_events_today Int   @default(0)

  updated_at      DateTime @updatedAt
}

// ==================== 系统配置 ====================

model SystemConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           Json
  description     String?

  updated_at      DateTime @updatedAt
}

// ==================== VWAP v2 人类属性系统 ====================

/// 生理需求表
model PhysiologicalNeeds {
  id              String   @id @default(cuid())
  agent_id        String   @unique
  agent           Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  hunger          Int      @default(100)      // 0-100, 100 = 饱
  thirst          Int      @default(100)      // 0-100, 100 = 不渴
  fatigue         Int      @default(0)        // 0-100, 100 = 极度疲劳
  bathroom        Int      @default(0)        // 0-100, 100 = 急需
  comfort         Int      @default(50)       // 0-100, 舒适度
  health          Int      @default(100)      // 0-100, 健康状况

  last_updated    DateTime @default(now())

  @@index([agent_id])
}

/// 情感状态表
model EmotionalState {
  id                String   @id @default(cuid())
  agent_id          String   @unique
  agent             Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  primary_emotion   String   @default("neutral")
  secondary_emotion String?
  emotion_intensity Int      @default(50)
  mood_stability    Int      @default(50)

  // 情感影响因子
  stress_level      Int      @default(0)
  happiness_level   Int      @default(50)
  social_energy     Int      @default(50)

  // 情感历史（JSON存储，最多保留100条）
  emotion_history   Json?

  last_updated      DateTime @default(now())

  @@index([agent_id])
}

/// 技能表
model Skills {
  id              String   @id @default(cuid())
  agent_id        String   @unique
  agent           Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  // 技能数据存储为JSON，每个技能包含 level, experience, proficiency, potential
  programming     Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  cooking         Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  social          Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  creativity      Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  logic           Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  leadership      Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  negotiation     Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  art             Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  music           Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  athletics       Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")
  learning        Json     @default("{\"level\":1,\"experience\":0,\"proficiency\":\"novice\",\"potential\":50}")

  // 扩展技能（JSON存储自定义技能）
  extended_skills Json?    @default("{}")

  last_updated    DateTime @default(now())

  @@index([agent_id])
}

/// 虚拟形象表
model Avatar {
  id                String   @id @default(cuid())
  agent_id          String   @unique
  agent             Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  image_url         String
  thumbnail_url     String
  generation_prompt String

  // 头像配置（JSON存储）
  config            Json

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([agent_id])
}

/// 平台适配器表
model PlatformAdapter {
  id                String   @id @default(cuid())
  agent_id          String
  agent             Agent    @relation(fields: [agent_id], references: [agent_id], onDelete: Cascade)

  platform_type     String   // 'openai' | 'claude' | 'discord' | 'telegram' | 'slack' | 'custom'
  platform_user_id  String?
  webhook_url       String?
  config            Json?

  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([agent_id, platform_type])
  @@index([agent_id])
  @@index([platform_type])
}

// ==================== 3D虚拟空间扩展 ====================

/// 车辆表
model Vehicle {
  id                  String            @id @default(cuid())
  vehicle_id          String            @unique
  name                String
  type                String            // 'car' | 'bus' | 'truck' | 'motorcycle' | 'bicycle' | 'taxi'

  // 位置与姿态
  position            Json              // {x, y, z}
  rotation            Float             @default(0)
  speed               Float             @default(0)

  // 车辆属性
  capacity            Int               @default(4)
  max_speed           Float             @default(100)
  color               String
  status              String            @default("parked")

  // 关系
  current_driver_id   String?
  current_location_id String
  owner_agent_id      String?
  owner_agent         Agent?            @relation("vehicle_owner", fields: [owner_agent_id], references: [agent_id], onDelete: SetNull)

  // 车辆状态
  state               VehicleState?
  interactions        VehicleInteraction[]

  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([current_location_id])
  @@index([owner_agent_id])
  @@index([status])
}

/// 车辆状态表
model VehicleState {
  id                  String            @id @default(cuid())
  vehicle_id          String            @unique
  vehicle             Vehicle           @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)

  // 动态状态
  acceleration        Float             @default(0)
  steering_angle      Float             @default(0)
  fuel                Int?              @default(100)
  health              Int?              @default(100)

  // 导航状态
  current_road_id     String?
  destination_id      String?
  route_data          Json?

  // 统计数据
  total_distance      Float             @default(0)
  total_trips         Int               @default(0)

  updated_at          DateTime          @updatedAt

  @@index([vehicle_id])
}

/// 车辆交互记录表
model VehicleInteraction {
  id                  String            @id @default(cuid())
  vehicle_id          String
  vehicle             Vehicle           @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)

  agent_id            String
  agent               Agent             @relation("vehicle_interactions", fields: [agent_id], references: [agent_id], onDelete: Cascade)

  interaction_type    String            // 'enter' | 'exit' | 'start' | 'stop' | 'park' | 'drive' | 'collision'
  result              String?           // 'success' | 'failed'

  data                Json?
  timestamp           DateTime          @default(now())

  @@index([vehicle_id])
  @@index([agent_id])
  @@index([timestamp])
}

/// 地形特征表
model TerrainFeature {
  id                  String            @id @default(cuid())
  feature_id          String            @unique

  type                String            // 'mountain' | 'hill' | 'water' | 'river' | 'ocean' | 'plain' | 'forest'
  name                String?

  // 城市关联
  city_id             String?
  city                City?             @relation(fields: [city_id], references: [id], onDelete: SetNull)

  // 空间数据
  position            Json              // {x, y, z}
  size                Json              // {width, height, depth}

  // 真实世界坐标映射
  real_coordinates    Json?             // {lat, lng}

  // 地形特定属性
  metadata            Json?

  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([type])
  @@index([position])
  @@index([city_id])
}

/// 道路表
model Road {
  id                  String            @id @default(cuid())
  road_id             String            @unique

  name                String
  name_en             String?
  type                String            // 'highway' | 'main_road' | 'secondary_road' | 'alley' | 'ring_road'

  // 道路属性
  width               Float
  lanes               Int               @default(2)
  speed_limit         Float

  // 路径数据
  path                Json              // Array of {x, y, z}
  length              Float?

  // 拓扑关系
  is_one_way          Boolean           @default(false)
  has_lane_markings   Boolean           @default(true)
  connected_roads     String[]          // road IDs

  // 真实世界坐标映射
  real_coordinates    Json?             // {start: {lat, lng}, end: {lat, lng}, waypoints: [...]}

  metadata            Json?

  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([type])
  @@index([name])
}

// ==================== 城市地形系统 ====================

/// 城市配置表
model City {
  id                  String            @id @default(cuid())
  city_id             String            @unique

  // 基本信息
  name                String            // 中文名称
  name_en             String?           // 英文名称
  country             String            @default("中国")
  province            String?           // 省份

  // 地理边界 (1:1比例配置)
  min_lat             Float             // 最小纬度
  max_lat             Float             // 最大纬度
  min_lng             Float             // 最小经度
  max_lng             Float             // 最大经度

  // 中心点
  center_lat          Float
  center_lng          Float

  // 虚拟空间配置 (1:1比例: 1单位 = 1米)
  virtual_scale       Float             @default(1.0)
  virtual_center_x    Float             @default(0)
  virtual_center_z    Float             @default(0)

  // 地形数据源配置
  elevation_api       String?           // 'google' | 'opentopography' | 'open_elevation'
  terrain_source      String            @default("generated") // 'generated' | 'real_data'

  // 地形特征关联
  terrain_features    TerrainFeature[]

  // 缓存状态
  terrain_cached      Boolean           @default(false)
  terrain_cache_date  DateTime?

  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([name])
  @@index([country, province])
}
